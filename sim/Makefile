# Builds the co-simulator two ways from the same sources:
#   make native  -> build/libfarmesim.so      (Python analysis, tests)
#   make wasm    -> build/farmesim.wasm       (website; clang + wasm-ld + Binaryen wasm-opt)
#   make web     -> ../docs/js/farmesim-wasm.js (the .wasm, base64-embedded)
SRC = world.cpp rig.cpp mock.cpp fiber.cpp api.cpp \
      unit_drive.cpp unit_link.cpp \
      ../firmware/FarmeDrive/src/farme_proto.cpp ../firmware/FarmeDrive/src/drive_core.cpp \
      ../firmware/FarmeLink/src/link_core.cpp
DEPS = $(SRC) $(wildcard *.h arduino_mock/*.h arduino_mock/avr/*.h) \
       ../firmware/FarmeDrive/*.ino ../firmware/FarmeDrive/*.h ../firmware/FarmeDrive/src/*.h \
       ../firmware/FarmeLink/*.ino ../firmware/FarmeLink/*.h ../firmware/FarmeLink/src/*.h
# -ffp-contract=off: no fused multiply-add, so native and wasm agree bit for bit.
FLAGS = -O2 -std=c++17 -ffp-contract=off -fno-exceptions -fno-rtti -I. -Iarduino_mock -w
CXX = clang++

native: build/libfarmesim.so
wasm: build/farmesim.wasm
web: ../docs/js/farmesim-wasm.js

build/libfarmesim.so: $(DEPS)
	@mkdir -p build
	$(CXX) $(FLAGS) -fPIC -shared -o $@ $(SRC)

WOBJ = $(patsubst %.cpp,build/wasm/%.o,$(notdir $(SRC))) build/wasm/wasm_rt.o
vpath %.cpp . ../firmware/FarmeDrive/src ../firmware/FarmeLink/src

build/wasm/%.o: %.cpp $(DEPS)
	@mkdir -p build/wasm
	clang++ --target=wasm32 -nostdlib -ffreestanding -fvisibility=hidden $(FLAGS) -c -o $@ $<

build/farmesim-raw.wasm: $(WOBJ)
	wasm-ld --no-entry --export-dynamic --export=__wasm_call_ctors -z stack-size=262144 \
	  --initial-memory=67108864 --max-memory=268435456 -o $@ $(WOBJ)

# Asyncify lets a sketch's fiber unwind and later rewind its wasm stack.
build/farmesim.wasm: build/farmesim-raw.wasm
	wasm-opt $< --asyncify --pass-arg=asyncify-imports@env.fiber_suspend \
	  --pass-arg=asyncify-removelist@sim_fiber_resume -O2 --strip-debug -o $@

../docs/js/farmesim-wasm.js: build/farmesim.wasm
	@mkdir -p ../docs/js
	python3 -c "import base64;d=open('build/farmesim.wasm','rb').read();open('$@','w').write('// generated by sim/Makefile from the C++ simulator - do not edit\nexport const WASM_BASE64 = \"'+base64.b64encode(d).decode()+'\";\n')"

clean:
	rm -rf build
.PHONY: native wasm web clean
